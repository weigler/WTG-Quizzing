rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Modelos de quiz: só o admin autenticado lê e escreve.
    // O site jogo/ nunca acessa essa coleção diretamente — ele só
    // enxerga uma cópia das perguntas dentro da sessão ativa.
    match /quizzes/{quizId} {
      allow read, write: if request.auth != null;
    }

    match /sessions/{code} {
      // qualquer um pode ler UMA sessão específica se souber o código
      // (é assim que o site jogo/ funciona, sem login)
      allow get: if true;
      // mas ninguém de fora consegue LISTAR todas as sessões e "descobrir"
      // códigos e respostas de salas que não são a dele — isso é só pro admin
      allow list: if request.auth != null;
      // só o admin controla o andamento do jogo
      allow write: if request.auth != null;

      match /players/{playerId} {
        allow read: if true;
        // qualquer visitante pode entrar na sala (criar seu registro de jogador),
        // mas não pode editar o registro de ninguém — só o admin pode excluir
        // (usado ao apagar uma sessão inteira)
        allow create: if true;
        allow update: if false;
        allow delete: if request.auth != null;
      }

      match /answers/{answerId} {
        allow read: if request.auth != null; // só o admin lê pra corrigir
        // qualquer visitante pode enviar sua resposta, mas o id do
        // documento (questionIndex_playerId) impede reenvio/alteração —
        // só o admin pode excluir (usado ao apagar uma sessão inteira)
        allow create: if true;
        allow update: if false;
        allow delete: if request.auth != null;
      }

      match /scores/{playerId} {
        allow read: if true; // o jogador precisa ver a própria pontuação
        allow write: if request.auth != null; // só o admin grava pontos
      }
    }
  }
}
