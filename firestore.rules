rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Modelos de quiz: cada usuário autenticado só lê/edita/exclui os
    // PRÓPRIOS quizzes (campo ownerId = uid de quem criou). Um amigo não
    // vê nem consegue mexer nos quizzes de outro.
    match /quizzes/{quizId} {
      allow read, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId; // ninguém troca o dono depois
    }

    match /sessions/{code} {
      // qualquer um pode ler UMA sessão específica se souber o código
      // (é assim que o site jogo/ funciona, sem login) — isso não muda
      // com o dono, porque quem joga nunca está autenticado
      allow get: if true;
      // mas só o dono consegue LISTAR (ver na aba Sessões) as próprias salas
      allow list: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      match /players/{playerId} {
        allow read: if true;
        // qualquer visitante pode entrar na sala (criar seu registro de jogador)
        // e também sair (excluir o próprio registro) — mas não editar nem
        // excluir o de outra pessoa por engano, já que o id é aleatório e só
        // quem criou o registro sabe qual é o seu
        allow create: if true;
        allow update: if false;
        allow delete: if true;
      }

      match /answers/{answerId} {
        // leitura de UM documento específico (get) é pública — é assim que
        // o próprio jogador confere a própria resposta pra montar o PDF
        // pessoal dele, sem precisar estar logado. Só quem já sabe o id
        // exato (questionIndex_playerId) consegue, e só o dono da sessão
        // consegue LISTAR todas (list) pra corrigir as respostas de todo
        // mundo.
        allow get: if true;
        allow list: if request.auth != null
                    && get(/databases/$(database)/documents/sessions/$(code)).data.ownerId == request.auth.uid;
        // qualquer visitante pode enviar sua resposta, mas o id do
        // documento (questionIndex_playerId) impede reenvio/alteração —
        // só o dono pode excluir (usado ao apagar uma sessão inteira)
        allow create: if true;
        allow update: if false;
        allow delete: if request.auth != null
                      && get(/databases/$(database)/documents/sessions/$(code)).data.ownerId == request.auth.uid;
      }

      match /scores/{playerId} {
        allow read: if true; // o jogador precisa ver a própria pontuação
        // normalmente só o dono da sessão grava pontos (ele corrige cada
        // pergunta) — MAS no modo "corrida livre" não tem correção
        // centralizada, cada jogador avança sozinho, então o próprio
        // jogador grava a própria pontuação nesse modo específico
        allow write: if (request.auth != null
                         && get(/databases/$(database)/documents/sessions/$(code)).data.ownerId == request.auth.uid)
                     || get(/databases/$(database)/documents/sessions/$(code)).data.gameMode == "corrida";
      }

      match /bluffs/{bluffId} {
        // Modo Blefe: todo mundo precisa VER os blefes de todo mundo na
        // hora de votar (isso é o próprio mecanismo do jogo, não uma
        // brecha) — por isso leitura é pública, tanto get quanto list.
        allow read: if true;
        allow create: if true;
        allow update: if false;
        allow delete: if request.auth != null
                      && get(/databases/$(database)/documents/sessions/$(code)).data.ownerId == request.auth.uid;
      }

      match /votes/{voteId} {
        // igual os blefes: quem vota precisa ver quantos votos cada
        // resposta recebeu (é o próprio mecanismo do jogo), e cada
        // jogador precisa disso pra montar o próprio relatório/PDF
        // pessoal depois — por isso leitura é pública.
        allow read: if true;
        allow create: if true;
        allow update: if false;
        allow delete: if request.auth != null
                      && get(/databases/$(database)/documents/sessions/$(code)).data.ownerId == request.auth.uid;
      }

      match /ready/{readyId} {
        // botão "Continuar": cada jogador avisa que já viu a revelação ou
        // o placar. Leitura pública (o dono precisa contar quantos estão
        // prontos), qualquer um marca o próprio "pronto".
        allow read: if true;
        allow create: if true;
        allow update: if false;
        allow delete: if request.auth != null
                      && get(/databases/$(database)/documents/sessions/$(code)).data.ownerId == request.auth.uid;
      }
    }
  }
}
